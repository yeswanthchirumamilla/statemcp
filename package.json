{
  "name": "statemcp",
  "version": "1.0.0",
  "description": "Developer SDK to expose any product as a State-Aware Dynamic Model Context Protocol (MCP) server with agent state memory",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx test/sdk.test.ts",
    "example:crm": "tsx examples/crm-product.ts",
    "example:minimal": "tsx examples/minimal.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sdk",
    "ai-agent",
    "state-machine",
    "fsm",
    "agent-affordances",
    "dynamic-tools",
    "anthropic",
    "claude"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeswanthchirumamilla/statemcp.git"
  },
  "bugs": {
    "url": "https://github.com/yeswanthchirumamilla/statemcp/issues"
  },
  "homepage": "https://github.com/yeswanthchirumamilla/statemcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
